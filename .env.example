# Server Configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Telegram Bot Credentials
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=mock_bot_token_for_local_testing

# Telegram Channel for Incident Broadcasts
# Channel username (e.g. @statuscast_channel) or channel ID (-100xxxxxxx)
TELEGRAM_CHANNEL_ID=@statuscast_updates

# Security & Admin Access
# Shared secret for local REST admin calls when not using Telegram initData
ADMIN_SECRET=statuscast_dev_secret_change_in_prod

# Mini App Public URL (used when generating inline links in bot messages)
WEBAPP_URL=http://localhost:8080

# Demo Mode
# When true, seeds sample services (API Gateway, Web App, Database, Payments) and 90-day history
DEMO_MODE=true

# Database Storage Path
DATABASE_PATH=./data/statuscast.sqlite

# Automated Ping / Heartbeat Check Interval in seconds (default: 60)
MONITOR_INTERVAL_SECONDS=60
